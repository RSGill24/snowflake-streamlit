SELECT
    COUNT_IF(
        DURATION < 0
        OR TALK_TIME < 0
        OR HOLD_TIME < 0
    ) AS NEGATIVE_DURATION_COUNT,

    COUNT_IF(
        START_OFFSET < 0
        OR END_OFFSET < 0
        OR (
            START_OFFSET IS NOT NULL
            AND END_OFFSET IS NOT NULL
            AND END_OFFSET < START_OFFSET
        )
    ) AS INVALID_OFFSET_COUNT,

    COUNT_IF(
        DURATION IS NOT NULL
        AND TALK_TIME IS NOT NULL
        AND HOLD_TIME IS NOT NULL
        AND DURATION < TALK_TIME + HOLD_TIME
    ) AS DURATION_MISMATCH_COUNT,

    COUNT_IF(
        CREATE_TIMESTAMP IS NOT NULL
        AND UPDATE_TIMESTAMP IS NOT NULL
        AND UPDATE_TIMESTAMP < CREATE_TIMESTAMP
    ) AS INVALID_TIMESTAMP_ORDER_COUNT,

    COUNT_IF(
        INTERACTION_TIMESTAMP IS NULL
    ) AS MISSING_INTERACTION_TIMESTAMP_COUNT,

    COUNT_IF(
        CALLER_TYPE IS NULL
        OR DIRECTION IS NULL
        OR ORIG_ANI IS NULL
    ) AS MISSING_CALL_METADATA_COUNT

FROM SANDBOX_DB.EDW_STL_POC_SR.GEHA_CALL_TRANSCRIPTS
