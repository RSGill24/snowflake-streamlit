-- Snowflake Data Copy Utility - Customer Deployment SQL
-- Replace every <...> placeholder before running.
-- Use a dedicated application owner role; do NOT use ACCOUNTADMIN permanently.

-- 1. Application/control objects
CREATE DATABASE IF NOT EXISTS DATA_COPY_APP_DB;
CREATE SCHEMA IF NOT EXISTS DATA_COPY_APP_DB.STREAMLIT;

CREATE TABLE IF NOT EXISTS DATA_COPY_APP_DB.STREAMLIT.DATA_COPY_AUDIT
(
    RUN_ID              VARCHAR,
    RUN_TIMESTAMP       TIMESTAMP_NTZ,
    SOURCE_DATABASE     VARCHAR,
    SOURCE_SCHEMA       VARCHAR,
    SOURCE_TABLE        VARCHAR,
    TARGET_DATABASE     VARCHAR,
    TARGET_SCHEMA       VARCHAR,
    TARGET_TABLE        VARCHAR,
    COPY_MODE           VARCHAR,
    SOURCE_ROW_COUNT    NUMBER,
    TARGET_ROW_COUNT    NUMBER,
    STATUS              VARCHAR,
    ERROR_MESSAGE       VARCHAR,
    EXECUTED_BY         VARCHAR
);

-- 2. Dedicated roles
CREATE ROLE IF NOT EXISTS DATA_COPY_APP_OWNER;
CREATE ROLE IF NOT EXISTS DATA_COPY_APP_VIEWER;

-- 3. App owner access to application database/schema/audit table
GRANT USAGE ON DATABASE DATA_COPY_APP_DB TO ROLE DATA_COPY_APP_OWNER;
GRANT USAGE ON SCHEMA DATA_COPY_APP_DB.STREAMLIT TO ROLE DATA_COPY_APP_OWNER;
GRANT INSERT ON TABLE DATA_COPY_APP_DB.STREAMLIT.DATA_COPY_AUDIT TO ROLE DATA_COPY_APP_OWNER;

-- 4. Streamlit deployment/runtime privileges
GRANT CREATE STREAMLIT ON SCHEMA DATA_COPY_APP_DB.STREAMLIT TO ROLE DATA_COPY_APP_OWNER;
GRANT USAGE ON WAREHOUSE <APP_WAREHOUSE> TO ROLE DATA_COPY_APP_OWNER;
GRANT USAGE ON COMPUTE POOL <APP_COMPUTE_POOL> TO ROLE DATA_COPY_APP_OWNER;

-- 5. SOURCE database/schema read access
GRANT USAGE ON DATABASE SANDBOX_DB TO ROLE DATA_COPY_APP_OWNER;
GRANT USAGE ON SCHEMA SANDBOX_DB.POC TO ROLE DATA_COPY_APP_OWNER;
GRANT SELECT ON ALL TABLES IN SCHEMA SANDBOX_DB.POC TO ROLE <APP_OWNER_ROLE>;
GRANT SELECT ON FUTURE TABLES IN SCHEMA <SOURCE_DATABASE>.<SOURCE_SCHEMA> TO ROLE <APP_OWNER_ROLE>;

-- 6. SOURCE editing: add/edit/delete rows
GRANT INSERT ON ALL TABLES IN SCHEMA <SOURCE_DATABASE>.<SOURCE_SCHEMA> TO ROLE <APP_OWNER_ROLE>;
GRANT UPDATE ON ALL TABLES IN SCHEMA <SOURCE_DATABASE>.<SOURCE_SCHEMA> TO ROLE <APP_OWNER_ROLE>;
GRANT DELETE ON ALL TABLES IN SCHEMA <SOURCE_DATABASE>.<SOURCE_SCHEMA> TO ROLE <APP_OWNER_ROLE>;
GRANT INSERT ON FUTURE TABLES IN SCHEMA <SOURCE_DATABASE>.<SOURCE_SCHEMA> TO ROLE <APP_OWNER_ROLE>;
GRANT UPDATE ON FUTURE TABLES IN SCHEMA <SOURCE_DATABASE>.<SOURCE_SCHEMA> TO ROLE <APP_OWNER_ROLE>;
GRANT DELETE ON FUTURE TABLES IN SCHEMA <SOURCE_DATABASE>.<SOURCE_SCHEMA> TO ROLE <APP_OWNER_ROLE>;

-- 7. TARGET database/schema read access
GRANT USAGE ON DATABASE <TARGET_DATABASE> TO ROLE <APP_OWNER_ROLE>;
GRANT USAGE ON SCHEMA <TARGET_DATABASE>.<TARGET_SCHEMA> TO ROLE <APP_OWNER_ROLE>;
GRANT SELECT ON ALL TABLES IN SCHEMA <TARGET_DATABASE>.<TARGET_SCHEMA> TO ROLE <APP_OWNER_ROLE>;
GRANT SELECT ON FUTURE TABLES IN SCHEMA <TARGET_DATABASE>.<TARGET_SCHEMA> TO ROLE <APP_OWNER_ROLE>;

-- 8. TARGET data copy
GRANT INSERT ON ALL TABLES IN SCHEMA <TARGET_DATABASE>.<TARGET_SCHEMA> TO ROLE <APP_OWNER_ROLE>;
GRANT INSERT ON FUTURE TABLES IN SCHEMA <TARGET_DATABASE>.<TARGET_SCHEMA> TO ROLE <APP_OWNER_ROLE>;

-- Required by REPLACE mode because the application executes TRUNCATE TABLE.
GRANT TRUNCATE ON ALL TABLES IN SCHEMA <TARGET_DATABASE>.<TARGET_SCHEMA> TO ROLE <APP_OWNER_ROLE>;
GRANT TRUNCATE ON FUTURE TABLES IN SCHEMA <TARGET_DATABASE>.<TARGET_SCHEMA> TO ROLE <APP_OWNER_ROLE>;

-- 9. TARGET schema/table creation
-- Required only when the app must perform Copy Schema Only or Copy Schema and Data.
GRANT CREATE SCHEMA ON DATABASE <TARGET_DATABASE> TO ROLE <APP_OWNER_ROLE>;
GRANT CREATE TABLE ON SCHEMA <TARGET_DATABASE>.<TARGET_SCHEMA> TO ROLE <APP_OWNER_ROLE>;

-- 10. REPLACE mode
-- TRUNCATE is granted above. Do not grant broad OWNERSHIP just for REPLACE mode.
-- OWNERSHIP is only needed if the customer wants the application role to
-- perform ownership-level table operations beyond this application.

-- 11. Viewer access (owner-rights execution means viewers do not need direct table DML)
GRANT USAGE ON DATABASE <APP_DATABASE> TO ROLE <APP_VIEWER_ROLE>;
GRANT USAGE ON SCHEMA <APP_DATABASE>.<APP_SCHEMA> TO ROLE <APP_VIEWER_ROLE>;

-- After the Streamlit app is created:
-- GRANT USAGE ON STREAMLIT <APP_DATABASE>.<APP_SCHEMA>.<APP_NAME>
-- TO ROLE <APP_VIEWER_ROLE>;

