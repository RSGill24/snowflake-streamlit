-- If requirements.txt is installed from PyPI, the customer must provide
-- an approved External Access Integration/package-index configuration.
-- Then grant it to the app owner role and attach it to the app:
-- GRANT USAGE ON INTEGRATION <PYPI_EXTERNAL_ACCESS_INTEGRATION> TO ROLE <APP_OWNER_ROLE>;
-- ALTER STREAMLIT <APP_DATABASE>.<APP_SCHEMA>.<APP_NAME>
-- SET EXTERNAL_ACCESS_INTEGRATIONS = (<PYPI_EXTERNAL_ACCESS_INTEGRATION>);

